#!/bin/sh
# the turn went to OpenAI's Responses API (never Claude Code, whatever the
# wire), its key curl's to read; the second step sent the first output back
# as it came (the reasoning item and its encrypted content, the call), then
# the call's result
set -e
first=$(ls log/*.json | head -1)
last=$(ls log/*.json | tail -1)
test "$(ls log/*.json | wc -l)" -eq 2
jq -e '.argv[-1] == "https://api.openai.com/v1/responses"' "$last" > /dev/null
jq -e '.argv | index("--variable") as $i | .[$i + 1] == "%OPENAI_API_KEY"' "$last" > /dev/null
jq -e '.argv | any(. == "Authorization: Bearer {{OPENAI_API_KEY:trim}}")' "$last" > /dev/null
jq -e '.argv | all(test("sk-test") | not)' "$last" > /dev/null
jq -e '.body.model == "gpt-6.1-sol" and .body.store == false and .body.stream == false and .body.reasoning == {effort: "high", summary: "auto", context: "all_turns"} and .body.service_tier == "default"' "$first" > /dev/null
jq -e '.body.input[0].role == "developer" and (.body.input[0].content[0].text | startswith("You are mugen")) and .body.input[1].role == "user"' "$first" > /dev/null
jq -e '.body.tools | map(select(.name == "shell")) | .[0].type == "function" and .[0].strict == false and .[0].parameters.required == ["device", "command"]' "$first" > /dev/null
jq -e '.body.tools | any(.type == "web_search")' "$first" > /dev/null
jq -e '.body.input[2] == {"type": "reasoning", "id": "rs_1", "summary": [{"type": "summary_text", "text": "let me run it"}], "encrypted_content": "enc-1"}' "$last" > /dev/null
jq -e '.body.input[4].type == "function_call" and .body.input[4].call_id == "call_1"' "$last" > /dev/null
jq -e '.body.input[5] == {"type": "function_call_output", "call_id": "call_1", "output": [{"type": "input_text", "text": "hi\n(exit 0 in \(.body.input[5].output[0].text | capture("in (?<t>[0-9.]+) s").t) s)"}]}' "$last" > /dev/null
jq -e '.pick == {vendor: "openai-api", model: "gpt-6.1-sol", effort: "high", speed: "slow"}' "$1/view.json" > /dev/null
