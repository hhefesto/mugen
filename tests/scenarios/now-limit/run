#!/bin/sh
# /now (C-s on the screen) with the messages waiting on summaries that a
# usage limit holds: it says so once (what holds them, when it resets,
# /login), not on every press. The limit: run/limits.json "rejected" till
# 2100 (the claude wire's compactor keeps hitting it while $held is there;
# the api wire's, slow, keeps the summaries building)
mkdir -p "$MUGEN_DIR/run"
held=$PWD/held
echo 4102444800 > "$held"
printf '%s\n' '{"at":1,"info":{"status":"rejected","resetsAt":4102444800,"rateLimitType":"five_hour"}}' > "$MUGEN_DIR/run/limits.json"
export MUGEN_FAKE_COMPACT_LIMIT="$held" TZ=UTC
[ "$MUGEN_WIRE" = api ] && export MUGEN_FAKE_COMPACT_SLEEP=5
( echo ""; sleep 2; echo "second"; sleep 1; echo "/now"; sleep 0.5; echo "/now"; sleep 0.5; echo "/now"; sleep 1; rm -f "$held" ) | timeout 60 "$MUGEN"
