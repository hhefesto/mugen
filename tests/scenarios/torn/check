#!/bin/sh
set -e
day=$(ls "$1/main" | tail -1)
# the torn line stays, ended; the messages after it are whole and indexed
grep -c . "$1/main/$day" | grep -qx 5
tail -2 "$1/main/$day" | head -1 | jq -e '.text == "second" and .i == 2' > /dev/null
tail -1 "$1/main/$day" | jq -e '.text == "Two." and .i == 3' > /dev/null
