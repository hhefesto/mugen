#!/bin/sh
# A turn stopped at a usage limit goes on at once when Claude Code is signed
# in outside the chat, to another account (`mugen login` in another window):
# mugen sees its credentials change (CLAUDE_CONFIG_DIR, the sandbox's), asks
# who is signed in, and goes on as after /login. The limit resets a day away
# (the note's time masked). With --api, Claude Code's sign-in plays no part
[ "$MUGEN_WIRE" = api ] && exit 0
( echo "start"; sleep 3; printf 'c0de\n' | MUGEN_FAKE_LOGIN=c0de "$MUGEN" login > /dev/null 2>&1; sleep 9 ) | timeout 60 "$MUGEN" | sed 's/goes on by itself at [0-9:-]* *[0-9:]*,/goes on by itself at @TIME@,/'
# the limit's wake (a day's sleep)
pkill -f '^sleep 864[0-9][0-9]$' || true
