#!/bin/sh
# A turn stopped at a usage limit goes on at once when /login signs in to
# another account, told so; if that account is at its limit too, the call
# stops at it again and mugen waits as before, till the next sign-in goes
# on. The limits reset a day away (the note's time masked). With --api,
# Claude Code's sign-in plays no part: nothing to check
[ "$MUGEN_WIRE" = api ] && exit 0
( echo "start"; sleep 3; echo "/login"; sleep 4; echo "/login c0de"; sleep 5; echo "/login"; sleep 4; echo "/login c0de"; sleep 5 ) | MUGEN_FAKE_LOGIN=c0de timeout 60 "$MUGEN" | sed 's/goes on by itself at [0-9:-]* *[0-9:]*,/goes on by itself at @TIME@,/'
# the limit's wakes (a day's sleep each)
pkill -f '^sleep 864[0-9][0-9]$' || true
